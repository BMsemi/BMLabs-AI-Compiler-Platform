# Local development. Copy to .env; do not commit secrets.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8765
# Local development generates a private .local-secret if unset.
# DJANGO_SECRET_KEY=
# Set for PostgreSQL; otherwise local development uses SQLite.
# DATABASE_URL=postgresql://bmlabs:CHANGE_ME@localhost:5432/bmlabs
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=BM Labs <noreply@example.com>
# CSRF_TRUSTED_ORIGINS=https://compiler.example.com
# Only enable when the application is isolated behind a trusted TLS proxy.
TRUST_PROXY=0
# Reserved adapter settings; paths alone do not enable execution.
YOSYS_PATH=
# Optional; defaults to yosys-abc beside Yosys.
ABC_PATH=
IVERILOG_PATH=
VVP_PATH=
NEXTPNR_PATH=
FABULOUS_ROOT=
X2_RTL_ROOT=
AI_MODEL_ENDPOINT=
# Bounded Linear adapter; requires the existing BMsemi_Model/V2 source and Torch.
COMPILER_ENABLED=0
COMPILER_MODEL_REPO=
COMPILER_X1_REPO=
COMPILER_PYTHON=
COMPILER_WSL_DISTRO=Ubuntu-22.04
# Absolute Windows executable paths use native tools; /usr/... paths use WSL.
COMPILER_MAX_ARTIFACT_BYTES=134217728
# Separate Linux tools for the upstream reference fabric; this does not select a BM ASIC target.
FABULOUS_WSL_DISTRO=
FABULOUS_WSL_USER=bmlabs
FABULOUS_VENV=/opt/fabulous-venv
FABULOUS_CAD_BIN=/opt/eda-20260628/oss-cad-suite/bin
# Windows UNC path to /home/bmlabs/work/builds in the configured WSL distribution.
FABULOUS_WORK_ROOT=
# Host directory containing that distribution's VHDX; used for free-space checks.
FABULOUS_HOST_STORAGE=
