# Copy to .env in the deployment checkout on the hosting server.
# Fill secrets on the server. Do not replace the local preview's .env.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ai.bmsemiconnect.com
SITE_URL=https://ai.bmsemiconnect.com
CSRF_TRUSTED_ORIGINS=https://ai.bmsemiconnect.com
TRUST_PROXY=1

# Required: separate random secrets. Use a URL-safe PostgreSQL password.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# compose.yaml supplies DATABASE_URL, REDIS_URL and CELERY_BROKER_URL.

# Required for registration, email verification and password resets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Set a sender verified by your mail provider.
DEFAULT_FROM_EMAIL=BM Labs <noreply@bmsemiconnect.com>

# Keep execution disabled until trusted repositories/tools are configured.
COMPILER_ENABLED=0
COMPILER_MODEL_REPO=
COMPILER_X1_REPO=
COMPILER_PYTHON=
IVERILOG_PATH=
VVP_PATH=
YOSYS_PATH=
NEXTPNR_PATH=
FABULOUS_ROOT=
X2_RTL_ROOT=
AI_MODEL_ENDPOINT=
